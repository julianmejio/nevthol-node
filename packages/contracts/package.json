{
  "name": "@repo/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Contracts used across the project",
  "type": "module",
  "exports": {
    "./pb/*": {
      "import": "./src/generated/pb/*",
      "default": "./src/generated/pb/*"
    },
    "./player": {
      "import": "./src/player.ts",
      "default": "./src/player.ts"
    },
    "./error": {
      "import": "./src/error.ts",
      "default": "./src/error.ts"
    },
    "./gw2/v2": {
      "import": "./src/gw2/v2/index.ts",
      "default": "./src/gw2/v2/index.ts"
    },
    "./api-gateway/authentication": {
      "import": "./src/api-gateway/authentication.ts",
      "default": "./src/api-gateway/authentication.ts"
    },
    "./api-gateway/response-common": {
      "import": "./src/api-gateway/response-common.ts",
      "default": "./src/api-gateway/response-common.ts"
    }
  },
  "scripts": {
    "generate": "buf generate",
    "lint": "buf lint",
    "check-types": "tsc --noEmit",
    "build": "buf build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.69.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@repo/typescript-config": "workspace:*",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
