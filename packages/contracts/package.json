{
  "name": "@repo/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Contracts used across the project",
  "type": "module",
  "exports": {
    "./pb/*": {
      "types": "./dist/generated/pb/*.d.ts",
      "import": "./dist/generated/pb/*.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js"
    },
    "./gw2/v2": {
      "types": "./dist/gw2/v2/index.d.ts",
      "import": "./dist/gw2/v2/index.js"
    },
    "./api-gateway/authentication": {
      "types": "./dist/api-gateway/authentication.d.ts",
      "import": "./dist/api-gateway/authentication.js"
    },
    "./api-gateway/response-common": {
      "types": "./dist/api-gateway/response-common.d.ts",
      "import": "./dist/api-gateway/response-common.js"
    }
  },
  "scripts": {
    "generate": "buf generate",
    "lint": "buf lint && eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "buf build && tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "eslint": "catalog:"
  }
}
